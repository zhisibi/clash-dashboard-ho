/** Privacy policy and user agreement shown in the app. The texts are generated by scripts/gen-legal.py into i18n/. */
import { I18N } from './I18n';
import { AGREEMENT_ZH, PRIVACY_ZH } from './i18n/LegalZh';
import { AGREEMENT_EN, PRIVACY_EN } from './i18n/LegalEn';

export const LEGAL_DEVELOPER: string = 'zhisibi';
export const LEGAL_CONTACT: string = 'https://github.com/zhisibi';
/** Privacy policy version: bump on material changes so users are asked to accept again */
export const PRIVACY_VERSION: number = 1;

/** Privacy policy lines (markdown subset) in the current UI language */
export function privacyLines(): string[] {
  return I18N.lang === 'en' ? PRIVACY_EN : PRIVACY_ZH;
}

/** User agreement lines in the current UI language */
export function agreementLines(): string[] {
  return I18N.lang === 'en' ? AGREEMENT_EN : AGREEMENT_ZH;
}
